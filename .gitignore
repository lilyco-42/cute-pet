# cute-pet .gitignore
#
# 重写说明(2026-09-20):
# 旧版本里有若干条 "按后缀全仓通配" 的规则(*.png / *.ttf / *.zip / *.wav / *.ogg),
# 加上 3 条不锚定的裸目录名(characters/ tools/ lyco_chat/) —— 结果是 **136 个已经
# 纳入版本控制的运行时素材被自己的 .gitignore 命中**:
#
#   pet/assets/murasame_layers/*.png   117 个 <- *.png
#   pet/assets/font_wenkai.ttf           1 个 <- *.ttf
#   pet/assets/characters/*.json|txt     4 个 <- characters/
#   pet/tools/*                          7 个 <- tools/   (连新建的 setup 脚本都被吃掉)
#   pet/gdi_desktop/src/*                3 个 <- pet/gdi_desktop/
#   pet/host_app/**/base/media/*.png     2 个 <- *.png
#
# 这些素材都由 rust-embed 编译进二进制, 是构建必需的。被 ignore 意味着: git add 一个
# 新素材会静默失败, `git status` 永远看不见它们的改动, `git clean -xdf` 会把它们删掉。
#
# 本文件三条规矩:
#   1. 目录规则一律锚定(以 / 开头或含 /), 不用裸目录名去匹配任意层级
#   2. 素材目录(pet/assets/**)里不用任何后缀通配 —— 例外写死比整类静默丢失强
#   3. 要忽略的二进制产物按 "它在哪生成" 精确描述, 而不是 "它叫什么后缀"
#
# 自查命令(应恒为零输出):
#   git ls-files -i -c --exclude-standard

# ─────────────────────────── Rust / 构建产物 ───────────────────────────
/target/                              # 万一以后在仓库根开 crate
pet/target/
pet/build/
pet/dev/
pet/release/
pet/release_pkg/
pet/examples/                         # 本地试验田, 不是 cargo examples/
pet/index.html                        # wasm 调试产物(macroquad 生成)
pet/gdi_desktop/target/
pet/tools/extract_zh_corpus/target/
pet/vendor/*/target/
*.pdb
*.rlib

# ─────────────────────── 平台 / 安装包产物 ───────────────────────
/apk/
*.apk
*.hap
*.wasm                                # wasm job 产物, 由 CI artifact 承载
*.tar.gz                              # 各种工具链/SDK 下载包
pet/*.tar.gz

# ───────────────────────────── HarmonyOS ─────────────────────────────
/ohos-sdk/                            # setup-ohos-cargo-config.sh 约定解压到这里
pet/ohos-sdk/
pet/host_app/entry/build/
pet/host_app/.hvigor/
pet/host_app/entry/oh_modules/
pet/host_app/oh_modules/

# ─────────────────── 本地 TTS / SoVITS 声乐训练产物 ───────────────────
# 刻意写成 "目录/*.wav" 而不是全局 "*.wav": 后者会把 TTS 吐出来的音频和进版本库的
# 素材混为一谈。srt(字幕/时间轴)是有用的, 不忽略。
pet/assets/voice/*.wav
pet/assets/voice/*.mp3
pet/assets/voice_preset/*.wav
pet/assets/voice_preset/*.mp3
/assets/pet/murasame/corpus/voice/
/tts_audio/
/tts_audio_lanque/
/sovits_backup/
murasame_sovits_data.tar.gz
voice_index.csv
murasame*.list

# ─────────────────────── 本机热点 / 临时脚本输出 ───────────────────────
# 顺手写在仓库根的一次性产物。全部锚定到根, 不去匹配子目录。
/session-ses_*.md
/cs_*.py
/cs_*.mjs
/cloudstudio_main.js
/2026-*.txt
/flinger.txt
/xc_guide.md
/actionlint.tar.gz
/tmp_rd_ci.yml
/zcode-dump/
/*.log

# 本机截图 / 录屏 / 参考图(放仓库根或 /local-assets/ 下)
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.mp4
pet/*.png
pet/*.mp4
/local-assets/
/docs/screenshots-local/

# ─────────────────────────── Python 工具 ───────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ───────────────────────── OS / 编辑器 ─────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────── AI agent / 本地自动化配置 ───────────────────
/.agents/
/.claude/
/.opencode/
/.dsh-vision-toolkit/

# ─────────────── 历史遗留: 曾经以子目录形式存在过的兄弟项目 ───────────────
# 现在仓库里没有这些目录了, 留着防止哪天又在根下 clone 一份。
# 必须锚定到根 —— 未锚定的 "tools/" 会吃掉 pet/tools/, 见开头的重写说明。
/lyco_chat/
/lyco-engine/
/platform_check/
/characters/
/tools/
/assets/
/lazy-ply/                            # junction -> D:/Code/lazy-ply(独立 canonical 仓库)

# ─────────────── vendored 依赖: 连带进来的 CI / 无关配置 ───────────────
# crates.io 发布包不含 .github; 但如果哪天改成从 git clone vendor, 里面的 workflow
# 会被 GitHub Actions 直接捡起来跑 —— 那不是我们要的行为。
pet/vendor/miniquad-ply/.github/
pet/vendor/quad-snd/.github/
pet/vendor/macroquad-ply/.github/

# ─────────────────── 含本机路径 / 密钥的本地配置 ───────────────────
pet/assets/vlm_config.json

# ────────── WebView 壳(pet/webview/android)构建产物 ──────────
# bin/ = aapt2/d8 中间物 + 调试签名 keystore(含密钥, 绝不能入库)
# assets/pet/ = build.sh 组装出来的内容层(index.html / pet_bridge.js /
#               ply_bundle.js / app.wasm)。app.wasm 是构建产物, 且自测模式下
#               可能含第三方角色素材 —— 一律不入库, 由 build.sh 现组装。
pet/webview/android/bin/
pet/webview/android/assets/pet/*
!pet/webview/android/assets/pet/.gitkeep

# 壳内中文 TTS 的大文件: espeak-ng.wasm(18MB, 中文 G2P) 由 build.sh 缺失时拉取, 不进库。
# (注: 上面历史遗留的 `*.wasm` 那行行尾带 `#` 注释 —— .gitignore 不支持行尾注释,
#  该模式实际无效; 这里用显式路径, 不受影响。)
pet/webview/web/vendor/kokoro-zh/espeak-ng.wasm

# 壳内离线 TTS(sherpa-onnx)的第三方构建输入: AAR(48MB) / 中文模型包(31MB) /
# kotlin-stdlib(1.7MB) / 模型解包 —— 全部由 build.sh 缺失时拉取, 不进库。
pet/webview/android/third_party/

# 壳的 CI 产物输出(本地用 --out dist-shell 复现 CI 时产生)
/dist-shell/
pet/webview/android/dist-shell/

# ─────────────── 本机试验/打包中间产物(仓库根) ───────────────
# dist-assets 是本地角色素材中转目录 —— 含第三方版权素材, 绝不能入库;
# 其余两个是本机复现 CI 打包时的中间物。
/apk-out/
/build-tmp/
/dist-assets/

# ─────────────── 角色音频防线(ogg 是 wav/mp3 之外的漏网之鱼) ───────────────
# mur*.ogg = 柚子社角色语音, 入库即违反素材合规铁律;
# greeting/ = 本机生成的语音目录。srt 字幕仍入库(见上方 TTS 段说明)。
# 加入前自查: git ls-files pet/assets/voice 只应有 .srt。
pet/assets/voice/*.ogg
pet/assets/voice/greeting/

# 旧 kokoro TTS 实验拉取的 voice bin(4MB, 本机可再生)
pet/webview/web/voices/
